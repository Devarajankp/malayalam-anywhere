{
  "name": "malayalam-anywhere",
  "version": "0.1.0",
  "description": "Type Malayalam in any Windows program (Inscript, GIST, Typewriter, Panchari, Varityper) with Unicode or ML-TT / MLW-TT font output.",
  "main": "app/main.js",
  "scripts": {
    "bundle": "esbuild engine/core.ts --bundle --platform=node --format=cjs --outfile=app/engine.bundle.js",
    "start": "npm run bundle && electron .",
    "test": "tsx scripts/test-core.ts",
    "dist": "npm run bundle && electron-builder --win portable --x64"
  },
  "build": {
    "appId": "in.kuttipencil.malayalamanywhere",
    "productName": "Malayalam Anywhere",
    "files": ["app/**", "node_modules/koffi/**", "package.json"],
    "win": { "target": "portable" }
  },
  "dependencies": { "koffi": "^2.9.0" },
  "devDependencies": { "electron": "^33.0.0", "electron-builder": "^25.0.0", "esbuild": "^0.24.0", "tsx": "^4.19.0", "typescript": "^5.6.0" }
}
